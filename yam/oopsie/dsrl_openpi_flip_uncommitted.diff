index 68a8d11..e846dfd 100644
--- a/src/openpi/transforms.py
+++ b/src/openpi/transforms.py
@@ -334,6 +334,66 @@ class PromptFromLeRobotTask(DataTransformFn):
 
         return {**data, "prompt": prompt}
 
+
+def _as_prompt_str(value) -> str:
+    """Unwrap a prompt-like value (str / bytes / 0-d or 1-element array / list) to a plain str."""
+    if isinstance(value, bytes):
+        return value.decode("utf-8", "replace")
+    if isinstance(value, str):
+        return value
+    arr = np.asarray(value).reshape(-1)
+    if arr.size == 0:
+        return ""
+    item = arr[0]
+    if isinstance(item, bytes):
+        return item.decode("utf-8", "replace")
+    return str(item)
+
+
+@dataclasses.dataclass(frozen=True)
+class MetadataPrefixPrompt(DataTransformFn):
+    """Prepends a metadata token string to the language prompt for metadata-conditioned pretraining.
+
+    The prefix (e.g. ``"<opt=success> <speed=2> <emb=xarm7_single> <op=NAME> "``) is produced by the
+    oopsie converter and carried in the ``meta_prompt`` column. With probability ``dropout_p`` the whole
+    prefix is dropped (classifier-free-guidance style) so the model also learns the bare instruction.
+
+    Sibling of :class:`PromptFromLeRobotTask`; must run after the prompt is populated (e.g. by
+    ``PromptFromLeRobotTask`` / ``prompt_from_task=True``) and before ``TokenizePrompt``.
+    """
+
+    dropout_p: float = 0.1
+    meta_key: str = "meta_prompt"
+
+    def __call__(self, data: DataDict) -> DataDict:
+        if self.meta_key not in data or "prompt" not in data:
+            return data
+        prefix = _as_prompt_str(data[self.meta_key])
+        if not prefix:
+            return data
+        if np.random.rand() < self.dropout_p:
+            return data  # CFG: drop the whole metadata prefix
+        return {**data, "prompt": prefix + _as_prompt_str(data["prompt"])}
+
+
+@dataclasses.dataclass(frozen=True)
+class InjectConstantMetaPrefix(DataTransformFn):
+    """Writes a constant metadata-prefix string into the ``meta_key`` column.
+
+    For datasets whose LeRobot converter did NOT emit a per-frame ``meta_prompt`` column (e.g. the
+    ABC130k corpus, whose repos predate the oopsie metadata contract), this injects a fixed prefix
+    such as ``"<opt=success> <speed=1> <emb=yam_bimanual> <op=abc> "`` so the downstream
+    :class:`MetadataPrefixPrompt` (CFG dropout) sees it exactly as it would a converter-produced one.
+    The prefix encodes explicit, documented defaults; it must run before ``MetadataPrefixPrompt``.
+    """
+
+    prefix: str
+    meta_key: str = "meta_prompt"
+
+    def __call__(self, data: DataDict) -> DataDict:
+        return {**data, self.meta_key: self.prefix}
+
+
